{
  "name": "osu-tournament-portal",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manu028-727/osu-tournament-portal.git"
  },
  "homepage": "https://github.com/manu028-727/osu-tournament-portal#readme",
  "bugs": {
    "url": "https://github.com/manu028-727/osu-tournament-portal/issues"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "instance:provision": "node scripts/configure.mjs",
    "licenses": "node scripts/collect-notices.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint src services scripts tests *.ts *.mjs",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env.test node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:db:setup": "node scripts/test-database.mjs",
    "test:db:migrate": "node scripts/migrate-test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:e2e": "node --env-file-if-exists=.env.test node_modules/@playwright/test/cli.js test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@smithy/hash-node": "4.5.2",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/signature-v4": "5.7.4",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "brackets-manager": "^1.11.1",
    "brackets-model": "1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "httpxy": "0.5.5",
    "irc-framework": "4.14.0",
    "lucide-react": "^0.577.0",
    "next": "^16.4.2",
    "papaparse": "^5.7.0",
    "pg": "^8.16.3",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.1",
    "ws": "8.22.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/ws": "8.18.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "prettier": "^3.9.10",
    "prisma": "^7.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "sharp": "$sharp",
    "exceljs": {
      "uuid": "11.1.1",
      "unzipper": "0.12.5"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
