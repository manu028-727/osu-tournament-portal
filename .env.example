# Run ./portal setup for guided configuration and generated private credentials.
# Advanced manual setup: copy this file to .env and replace EVERY placeholder.
STACK_NAME=tournament-portal
COMPOSE_PROFILES=database,storage
WEB_BIND=127.0.0.1
WEB_PORT=3335
POSTGRES_DB=tournament
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
APP_DATABASE_USER=tournament_app
APP_DATABASE_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
APP_DATABASE_NAME=tournament
DATABASE_URL=postgresql://tournament_app:REPLACE_WITH_DIFFERENT_RANDOM_SECRET@postgres:5432/tournament
DIRECT_URL=postgresql://postgres:REPLACE_WITH_RANDOM_SECRET@postgres:5432/tournament
APP_URL=https://cup.example.com
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=
OSU_REDIRECT_URI=https://cup.example.com/api/auth/callback
OWNER_OSU_ID=
INITIAL_SITE_NAME='osu! Tournament Portal'
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=/var/lib/tournament/uploads
S3_ENDPOINT=http://object-storage:9000
S3_REGION=us-east-1
S3_BUCKET=tournament-media
S3_ACCESS_KEY_ID=REPLACE_WITH_RANDOM_APP_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_RANDOM_APP_SECRET
S3_FORCE_PATH_STYLE=true
RUSTFS_ACCESS_KEY=REPLACE_WITH_RANDOM_ROOT_KEY
RUSTFS_SECRET_KEY=REPLACE_WITH_RANDOM_ROOT_SECRET
IRC_ENABLED=false
IRC_GATEWAY_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
